num = int(input("ingresar un numero: "))
primos = 0
for i in range (2, num+1):
    no_pri = 0
    for j in range(2, i):
        if i % j == 0:
            no_pri = 1
            break
    if no_pri == 0:
        print(i)
        primos += 1
print(f"Hay un total de {primos} numeros primos")
