#7
suma_pos = 0
prod_neg = 1
seguir = "si"
while seguir == "si":
    num = float(input("Ingrese un número: "))
    if num > 0:
        suma_pos += num
    elif num < 0:
        prod_neg *= num
    seguir = input("Continuar? (si/no): ")
print(suma_pos)
print(prod_neg)

